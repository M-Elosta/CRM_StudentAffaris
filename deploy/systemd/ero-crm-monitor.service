# Employer Relations CRM — health, disk, backup, certificate and integrity checks.
# Started once a day by ero-crm-monitor.timer (IT's own monitoring can run it more often with --json). Run by hand (no root needed) with:
#   sudo -u ero-crm /usr/bin/node --env-file=/etc/ero-crm/ero-crm.env /opt/ero-crm/current/scripts/ops/monitor.js

[Unit]
Description=Employer Relations CRM monitoring checks
Documentation=file:///opt/ero-crm/current/RUNBOOK.md
ConditionPathExists=/opt/ero-crm/current/scripts/ops/monitor.js
OnFailure=ero-crm-alert@%n.service

[Service]
Type=oneshot
User=ero-crm
Group=ero-crm
WorkingDirectory=/opt/ero-crm/current
EnvironmentFile=/etc/ero-crm/ero-crm.env
ExecStart=/usr/bin/node /opt/ero-crm/current/scripts/ops/monitor.js
TimeoutStartSec=2min

UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/ero-crm
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
