# Employer Relations CRM — weekly database consistency check (read-only).
# Started by ero-crm-integrity.timer. Run by hand with:
#   sudo systemctl start ero-crm-integrity.service

[Unit]
Description=Employer Relations CRM database integrity check
Documentation=file:///opt/ero-crm/current/RUNBOOK.md
ConditionPathExists=/opt/ero-crm/current/scripts/ops/integrity-check.js
OnFailure=ero-crm-alert@%n.service

[Service]
Type=oneshot
User=ero-crm
Group=ero-crm
WorkingDirectory=/opt/ero-crm/current
EnvironmentFile=/etc/ero-crm/ero-crm.env
ExecStart=/usr/bin/node /opt/ero-crm/current/scripts/ops/integrity-check.js
ExecStartPost=-/usr/bin/node /opt/ero-crm/current/scripts/ops/alert.js --recovered %n
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle

UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
# Writable because SQLite needs the -shm file even for read-only access in WAL mode,
# and the result is written to BACKUP_DIR/last-integrity.json.
ReadWritePaths=/var/lib/ero-crm /var/backups/ero-crm
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
