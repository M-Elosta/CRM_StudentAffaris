# Employer Relations CRM — web application.
# Installed to /etc/systemd/system/ero-crm.service by deploy/install.sh.
# Listens on 127.0.0.1:3000; nginx terminates TLS in front of it.

[Unit]
Description=Employer Relations CRM (web application)
Documentation=file:///opt/ero-crm/current/DEPLOYMENT.md file:///opt/ero-crm/current/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# Nothing to run until the first release is deployed with deploy/deploy.sh.
ConditionPathExists=/opt/ero-crm/current/src/server.js
# Give up after 5 failed starts within 10 minutes instead of restarting forever.
StartLimitIntervalSec=10min
StartLimitBurst=5
OnFailure=ero-crm-alert@%n.service

[Service]
Type=simple
User=ero-crm
Group=ero-crm
WorkingDirectory=/opt/ero-crm/current
EnvironmentFile=/etc/ero-crm/ero-crm.env
# Node runs directly (not through npm) so that signals reach the application.
ExecStart=/usr/bin/node /opt/ero-crm/current/src/server.js
Restart=on-failure
RestartSec=5s
# On SIGTERM the application waits up to 10 s for open requests, then exits.
KillSignal=SIGTERM
TimeoutStopSec=30s
# Pending migrations run at start-up, before the port opens.
TimeoutStartSec=300s

# ── Hardening ────────────────────────────────────────────────────────────────
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ero-crm /var/backups/ero-crm
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
# MemoryDenyWriteExecute is deliberately not set: V8's JIT compiler needs
# writable and executable memory, and Node.js aborts at start-up without it.

[Install]
WantedBy=multi-user.target
