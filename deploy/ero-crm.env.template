# Employer Relations CRM — production configuration
#
# /etc/ero-crm/ero-crm.env  (mode 0640, owner root, group ero-crm)
# Created by deploy/install.sh. Read by systemd (EnvironmentFile=) and by the
# operations scripts (node --env-file=...). Every variable is described in
# .env.example in the release.
#
# Format: one KEY=value per line, no spaces around "=", no quotes needed.
# Lines starting with # are comments. Do not put "#" inside a value.
#
# After editing: sudo systemctl restart ero-crm.service

NODE_ENV=production

# ── Network ──────────────────────────────────────────────────────────────────
# The application listens on loopback only; nginx terminates TLS in front of it.
HOST=127.0.0.1
PORT=3000
# CHANGE_ME: the public address of the site, exactly as users type it.
BASE_URL=https://CHANGE_ME.example.edu

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_PATH=/var/lib/ero-crm/employer.db
BACKUP_DIR=/var/backups/ero-crm
# Backups are encrypted with this key. Keep a second copy away from this server.
BACKUP_KEY_FILE=/etc/ero-crm/backup.key

# ── Off-server backup copy (set exactly one; see DEPLOYMENT.md) ──────────────
# A backup that exists only on this server does not protect against losing it.
# Either a mounted network share. Also make it writable for the backup job:
#   sudo systemctl edit ero-crm-backup.service   and add
#   [Service]
#   ReadWritePaths=/mnt/ero-crm-backups
# BACKUP_REMOTE_DIR=/mnt/ero-crm-backups
# Or a command IT provides, run without a shell; {file} is the encrypted file.
# BACKUP_REMOTE_COMMAND=scp -q -B -i /etc/ero-crm/backup-ssh-key {file} backup@CHANGE_ME.example.edu:/srv/ero-crm/

# Retention (defaults shown).
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_PRE_CHANGE_DAYS=30

# ── Secrets (generated at install; never share or commit) ────────────────────
SESSION_SECRET=@SESSION_SECRET@

# One-time password for the first administrator, used only while no users exist.
# Sign in, change the password, then delete this line and restart the service.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=@BOOTSTRAP_ADMIN_PASSWORD@

# ── Alerts (see RUNBOOK.md) ──────────────────────────────────────────────────
# Failed backups, integrity checks and monitoring runs always write an alert to
# the journal. To also send it on, give a command (run without a shell);
# {subject} and {body} are replaced, and the body is also on standard input.
# ALERT_COMMAND=mail -s {subject} it-alerts@CHANGE_ME.example.edu

# ── Monitoring thresholds (defaults shown) ───────────────────────────────────
# MONITOR_MIN_FREE_MB=1024
# MONITOR_MAX_BACKUP_AGE_HOURS=26
# MONITOR_MAX_INTEGRITY_AGE_DAYS=8
# MONITOR_MIN_CERT_DAYS=21
# MONITOR_TLS_CERT_FILE=/etc/ssl/CHANGE_ME/ero-crm.fullchain.pem
