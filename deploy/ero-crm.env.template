# Employer Relations CRM — production configuration
#
# /etc/ero-crm/ero-crm.env  (mode 0640, owner root, group ero-crm)
# Created by deploy/install.sh. Read by systemd (EnvironmentFile=) and by the
# operations scripts. One KEY=value per line, no quotes needed, no spaces
# around "=". Every variable is described in .env.example in the release.
#
# After editing: sudo systemctl restart ero-crm.service

NODE_ENV=production

# ── Network ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000
# CHANGE_ME: the public address of the site, exactly as users type it.
BASE_URL=https://CHANGE_ME.example.edu

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_PATH=/var/lib/ero-crm/employer.db
BACKUP_DIR=/var/backups/ero-crm
BACKUP_KEY_FILE=/etc/ero-crm/backup.key

# ── Off-server backup copy (set exactly one; see DEPLOYMENT.md) ──────────────
# A backup that exists only on this server does not protect against losing it.
# A mounted network share (also add it to ReadWritePaths of ero-crm-backup.service):
# BACKUP_REMOTE_DIR=/mnt/ero-crm-backups
# Or a command IT provides, run without a shell; {file} is the encrypted file.
# Do not use quotes in this value; put anything complex in a script instead.
# BACKUP_REMOTE_COMMAND=scp -q -B -i /etc/ero-crm/backup-ssh-key -o UserKnownHostsFile=/etc/ero-crm/backup-known-hosts {file} backup@CHANGE_ME.example.edu:/srv/ero-crm/

# ── Secrets (generated at install; never share or commit) ────────────────────
SESSION_SECRET=@SESSION_SECRET@

# One-time password for the first administrator. Used only when no users exist.
# Sign in, change the password, then delete this line and restart the service.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=@BOOTSTRAP_ADMIN_PASSWORD@

# ── Alerts (see RUNBOOK.md) ──────────────────────────────────────────────────
# ALERT_SMTP_HOST=CHANGE_ME-smtp-relay.example.edu
# ALERT_SMTP_PORT=25
# ALERT_FROM=ero-crm@CHANGE_ME.example.edu
# ALERT_TO=it-alerts@CHANGE_ME.example.edu
# ALERT_REPEAT_HOURS=6

# ── Monitoring thresholds (defaults shown) ───────────────────────────────────
# MONITOR_MIN_FREE_MB=1024
# MONITOR_MAX_BACKUP_AGE_HOURS=26
# MONITOR_MIN_CERT_DAYS=21
# Read the certificate from a file instead of connecting to BASE_URL:
# MONITOR_TLS_CERT_FILE=/etc/ssl/certs/CHANGE_ME.pem
