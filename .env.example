# Employer Relations CRM — configuration
#
# Copy to ".env" for local development, or to the systemd EnvironmentFile on a
# server. Real environment variables always win over this file.
# Never commit a filled-in copy.

# ── Environment ──────────────────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development

# ── Network ──────────────────────────────────────────────────────────────────
# The app listens on loopback and is reached through nginx in staging/production.
HOST=127.0.0.1
PORT=3000
# Public address of the site, e.g. https://ero-crm.qatar.cmu.edu
# Required in staging/production: used to verify that write requests come from this site.
BASE_URL=
# How many reverse proxies sit in front of the app. Default: 1 in staging/production, off in development.
# TRUST_PROXY=1

# ── Data ─────────────────────────────────────────────────────────────────────
# Required in staging/production. Must be on a local disk, outside the application folder.
# Development default: ./data/dev/employer.db
DATABASE_PATH=
# Required in staging/production. Where verified backups are written.
BACKUP_DIR=
# Number of local backups to keep.
# BACKUP_RETENTION=14

# ── Sessions ─────────────────────────────────────────────────────────────────
# Required in staging/production. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Cookies are HTTPS-only in staging/production. Set to false only for a local test over plain HTTP.
# SESSION_COOKIE_SECURE=true
# Absolute session lifetime, from sign-in, however active the user is.
# SESSION_MAX_AGE_MINUTES=720
# A session unused for this long expires. Activity extends it, never beyond the absolute lifetime.
# SESSION_IDLE_MINUTES=30

# ── First administrator ──────────────────────────────────────────────────────
# Used once, when no users exist yet. Required for the first start in staging/production.
# At least 12 characters. Remove it from this file after the first sign-in.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ── Limits ───────────────────────────────────────────────────────────────────
# API_RATE_LIMIT_PER_MINUTE=600
# LOGIN_RATE_LIMIT_PER_15_MIN=10
# JSON_BODY_LIMIT=1mb

# ── Other ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# APP_TIME_ZONE=Asia/Qatar

# ── Operations ───────────────────────────────────────────────────────────────
# Read only by the operations scripts (scripts/backup.js, scripts/restore.js,
# scripts/ops/*) through src/config/ops.js. See DEPLOYMENT.md and RUNBOOK.md.
# BACKUP_RETENTION above is not used by scripts/backup.js; it uses the
# BACKUP_KEEP_* rules below.

# Backup encryption key: a file holding 32 random bytes in base64. Create it with
#   node scripts/ops/generate-backup-key.js /etc/ero-crm/backup.key
# Required in staging/production (unencrypted backups are refused there).
# Optional in development. Keep a second copy away from this server: without
# the key, no backup can be restored.
BACKUP_KEY_FILE=

# Off-server copy of every backup. Set one of the two.
# A directory on a mounted network share. Never created automatically.
# BACKUP_REMOTE_DIR=/mnt/ero-crm-backups
# A command run without a shell for each encrypted file; {file} is replaced by
# its path and {name} by its file name. Non-zero exit = failure.
# BACKUP_REMOTE_COMMAND=scp -q -B {file} backup@backup-host.example.edu:/srv/ero-crm/
# BACKUP_REMOTE_TIMEOUT_SECONDS=1800

# Retention, applied to BACKUP_DIR and BACKUP_REMOTE_DIR after each backup.
# Dates come from the file name, in APP_TIME_ZONE (Asia/Qatar).
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
# pre-migration-* and pre-deploy-* backups are also kept this many days.
# BACKUP_KEEP_PRE_CHANGE_DAYS=30

# Monitoring (scripts/ops/monitor.js).
# MONITOR_MIN_FREE_MB=1024
# MONITOR_MAX_BACKUP_AGE_HOURS=26
# MONITOR_MAX_INTEGRITY_AGE_DAYS=8
# MONITOR_HEALTH_TIMEOUT_MS=5000
# A PEM certificate whose expiry is checked; optional.
# MONITOR_TLS_CERT_FILE=/etc/ssl/certs/ero-crm.pem
# MONITOR_MIN_CERT_DAYS=21

# Alerts (scripts/ops/alert.js, started by systemd when a timer job fails).
# Always written to the journal. If set, this command also runs, without a
# shell; {subject} and {body} are replaced, or both are appended as the last two
# arguments. The body is also given on standard input.
# ALERT_COMMAND=mail -s {subject} it-alerts@example.edu
