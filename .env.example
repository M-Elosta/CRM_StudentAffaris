# Employer Relations CRM — environment configuration
# Copy to .env (or export in your shell / process manager) and adjust.
# Note: the app reads these from process.env; use a loader (e.g. `node --env-file=.env server.js`)
# or export them before starting the server.

# Port the HTTP server listens on. Default: 3000
PORT=3000

# Secret used to sign session cookies. REQUIRED for production.
# If unset, a random secret is generated at every boot, which means all
# sessions are invalidated whenever the server restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for the default "admin" user that is seeded on first run
# (only used when the Users table is empty). Default if unset: admin123
ADMIN_PASSWORD=

# Set to 1 (or true) when the app is served over HTTPS (typically behind a
# reverse proxy). This marks the session cookie as Secure and enables
# Express "trust proxy" so req.ip and secure-cookie detection work correctly.
# Leave 0 for plain-HTTP local/dev use, otherwise logins will not stick.
COOKIE_SECURE=0
