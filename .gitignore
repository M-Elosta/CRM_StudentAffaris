# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Logs and runtime output
logs/
*.log
npm-debug.log*

# Test and tooling output
coverage/
test-results/
playwright-report/
.lighthouseci/

# Editors, OS files, AI tool runtime state
.DS_Store
Thumbs.db
