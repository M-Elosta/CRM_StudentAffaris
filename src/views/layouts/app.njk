{#
  Signed-in application shell: sidebar, top bar, main region.

  Expects from the controller (see src/web/locals.js):
    currentUser   { displayName, roleLabel }
    nav           [{ heading, items: [{ href, label, icon, count?, current }] }]
                  built on the server from the user's permissions, so nothing
                  appears and then disappears after load
    flash         [{ kind: 'success'|'error', message, undoUrl? }]
    session       { idleSeconds, warnSeconds }

  Navigation between pages uses hx-boost on <body>: the server still renders a
  complete page, htmx swaps only #main and updates the title and URL, so the
  sidebar and top bar never repaint. #nav and #toasts are refreshed alongside
  (hx-select-oob) so the active item and any message stay correct.
#}
{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import icon %}

{% block bodyAttributes %}hx-boost="true" hx-target="#main" hx-select="#main" hx-swap="outerHTML show:window:top" hx-select-oob="#nav,#toasts" hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}' data-session-idle="{{ session.idleSeconds }}" data-session-warn="{{ session.warnSeconds }}"{% endblock %}

{% block body %}
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="app">
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true"></span>
        <span class="brand__name">Employer Relations<span class="brand__org">CMU-Q</span></span>
      </a>
      {% include "partials/nav.njk" %}
    </aside>

    <header class="topbar">
      <button class="btn btn--ghost btn--icon topbar__menu-button" type="button" data-action="toggle-sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Open navigation">
        {{ icon('menu') }}
      </button>

      <form class="topbar__search" action="/search" method="get" role="search">
        <div class="input-group">
          {{ icon('search') }}
          <label class="visually-hidden" for="global-search">Search employers, contacts and events</label>
          <input class="input" id="global-search" name="q" type="search" dir="auto" autocomplete="off"
                 placeholder="Search employers, contacts, events"
                 hx-get="/search/suggest" hx-trigger="input changed delay:250ms, focus" hx-target="#search-suggestions" hx-swap="innerHTML" hx-push-url="false"
                 aria-controls="search-suggestions" data-shortcut="/" />
          <kbd class="input-group__kbd" aria-hidden="true">/</kbd>
        </div>
        <div id="search-suggestions" class="menu" role="listbox" hidden></div>
      </form>

      <div class="topbar__spacer"></div>

      <details class="account-menu" data-menu>
        <summary class="account" aria-label="Account: {{ currentUser.displayName }}, {{ currentUser.roleLabel }}">
          {{ icon('user') }}
          <span class="account__name" dir="auto">{{ currentUser.displayName }}</span>
          <span class="badge badge--plain">{{ currentUser.roleLabel }}</span>
          {{ icon('chevron-down') }}
        </summary>
        <div class="menu menu--end" role="menu">
          <div class="menu__label">Signed in as {{ currentUser.username }}</div>
          <a class="menu__item" role="menuitem" href="/account">{{ icon('settings') }} Account and security</a>
          <div class="menu__separator" role="separator"></div>
          <form action="/auth/sign-out" method="post" hx-boost="false">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="menu__item" role="menuitem" type="submit">{{ icon('logout') }} Sign out</button>
          </form>
        </div>
      </details>
    </header>

    <main class="main {% block mainClass %}{% endblock %}" id="main" tabindex="-1">
      {% block content %}{% endblock %}
    </main>
  </div>

  {# One dialog for the whole app. Forms are loaded into it with hx-target="#dialog-body". #}
  <dialog class="dialog" id="dialog" aria-labelledby="dialog-title" data-dialog>
    <div id="dialog-body"></div>
  </dialog>

  {# Session expiry warning: shown by app.js a little before the idle limit. #}
  <dialog class="dialog dialog--sm" id="session-warning" aria-labelledby="session-warning-title">
    <div class="dialog__header"><h2 id="session-warning-title">Still there?</h2></div>
    <div class="dialog__body">
      <p>You will be signed out in <strong data-session-countdown>2 minutes</strong> because there has been no activity. Anything you have typed stays on this page.</p>
    </div>
    <div class="dialog__footer">
      <button class="btn btn--primary" type="button" data-action="extend-session">Stay signed in</button>
    </div>
  </dialog>

  <div class="toasts" id="toasts" role="status" aria-live="polite" aria-atomic="false">
    {% for message in flash %}
      <div class="toast {% if message.kind == 'error' %}toast--error{% endif %}" data-toast {% if message.kind == 'error' %}role="alert"{% endif %}>
        <span class="toast__message">{{ message.message }}</span>
        {% if message.undoUrl %}
          <form action="{{ message.undoUrl }}" method="post">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <button class="toast__action" type="submit">Undo</button>
          </form>
        {% endif %}
        <button class="toast__close" type="button" data-action="dismiss-toast" aria-label="Dismiss">{{ icon('close') }}</button>
      </div>
    {% endfor %}
  </div>
{% endblock %}
