{#
  Shared interface components. Every screen is assembled from these, so a
  button, a field or a table looks and behaves the same everywhere.

  Import what you need:
    {% from "macros/ui.njk" import icon, button, field, pageHeader %}
#}

{# ── Icon ─────────────────────────────────────────────────────────────────
   Decorative by default. Give `label` only when the icon stands alone. #}
{% macro icon(name, label='') -%}
  <svg class="icon" {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %} focusable="false"><use href="/assets/icons.svg#{{ name }}"></use></svg>
{%- endmacro %}

{# ── Button ───────────────────────────────────────────────────────────────
   variant: '' | 'primary' | 'danger' | 'danger-solid' | 'ghost'
   A button that submits or triggers a request shows a spinner and is disabled
   while the request runs (app.js sets aria-busy from htmx events), so nothing
   can be submitted twice. #}
{% macro button(label, variant='', type='button', iconName='', attrs='', small=false, id='') -%}
  <button class="btn{% if variant %} btn--{{ variant }}{% endif %}{% if small %} btn--sm{% endif %}" type="{{ type }}" {% if id %}id="{{ id }}"{% endif %} {{ attrs | safe }}>
    <span class="btn__spinner" aria-hidden="true"></span>
    {%- if iconName %}{{ icon(iconName) }}{% endif -%}
    <span>{{ label }}</span>
  </button>
{%- endmacro %}

{% macro linkButton(label, href, variant='', iconName='', attrs='', small=false) -%}
  <a class="btn{% if variant %} btn--{{ variant }}{% endif %}{% if small %} btn--sm{% endif %}" href="{{ href }}" {{ attrs | safe }}>
    {%- if iconName %}{{ icon(iconName) }}{% endif -%}
    <span>{{ label }}</span>
  </a>
{%- endmacro %}

{% macro iconButton(label, iconName, attrs='', variant='ghost', small=true) -%}
  <button class="btn btn--icon btn--{{ variant }}{% if small %} btn--sm{% endif %}" type="button" aria-label="{{ label }}" title="{{ label }}" {{ attrs | safe }}>
    <span class="btn__spinner" aria-hidden="true"></span>{{ icon(iconName) }}
  </button>
{%- endmacro %}

{# ── Form fields ──────────────────────────────────────────────────────────
   `form` is the object the controller passes for every form:
     form.values  { name: value }   what to show (submitted values after an error)
     form.errors  { name: message } one specific sentence per invalid field
   The error line is always rendered (empty when valid) so a message appearing
   never moves the layout. #}
{# The wrapper of a field, in two halves around the control. (Not a {% call %} block:
   Nunjucks 3 does not pass a macro's keyword arguments into a caller body.) #}
{% macro _open(name, label, required, full) -%}
  <div class="field{% if full %} form-grid__full{% endif %}">
    <label class="field__label" for="f-{{ name }}">{{ label }}{% if required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}</label>
{%- endmacro %}

{% macro _close(name, form, hint) -%}
    {% if hint %}<span class="field__hint" id="f-{{ name }}-hint">{{ hint }}</span>{% endif %}
    <span class="field__error" id="f-{{ name }}-error" aria-live="polite">{{ form.errors[name] }}</span>
  </div>
{%- endmacro %}

{% macro _aria(name, form, required, hint) -%}
  {% if required %}required aria-required="true"{% endif %}
  {% if form.errors[name] %}aria-invalid="true"{% endif %}
  aria-describedby="f-{{ name }}-error{% if hint %} f-{{ name }}-hint{% endif %}"
{%- endmacro %}

{# type: text | email | url | tel | date | time | number | search
   userText=true for anything a person types freely (names, titles): sets dir="auto". #}
{% macro field(name, label, form, type='text', required=false, hint='', full=false, userText=true, maxlength=255, attrs='', autocomplete='off') -%}
  {{ _open(name, label, required, full) }}
    <input class="input" id="f-{{ name }}" name="{{ name }}" type="{{ type }}" value="{{ form.values[name] }}"
           {% if userText and type in ['text', 'search'] %}dir="auto"{% endif %}
           {% if type in ['text', 'email', 'url', 'tel', 'search'] %}maxlength="{{ maxlength }}"{% endif %}
           autocomplete="{{ autocomplete }}" {{ _aria(name, form, required, hint) }} {{ attrs | safe }} />
  {{ _close(name, form, hint) }}
{%- endmacro %}

{% macro textarea(name, label, form, required=false, hint='', full=true, rows=4, maxlength=2000) -%}
  {{ _open(name, label, required, full) }}
    <textarea class="textarea" id="f-{{ name }}" name="{{ name }}" rows="{{ rows }}" maxlength="{{ maxlength }}" dir="auto"
              {{ _aria(name, form, required, hint) }}>{{ form.values[name] }}</textarea>
  {{ _close(name, form, hint) }}
{%- endmacro %}

{# options: [{ value, label }] or plain strings. placeholder adds an empty first option. #}
{% macro select(name, label, form, options, required=false, hint='', full=false, placeholder='Select…', attrs='') -%}
  {{ _open(name, label, required, full) }}
    <select class="select" id="f-{{ name }}" name="{{ name }}" {{ _aria(name, form, required, hint) }} {{ attrs | safe }}>
      {% if placeholder %}<option value="">{{ placeholder }}</option>{% endif %}
      {% for option in options %}
        {% set value = option.value if option.value is defined else option %}
        {% set text = option.label if option.label is defined else option %}
        <option value="{{ value }}" {% if form.values[name] is defined and form.values[name] !== null and (form.values[name] | string) == (value | string) %}selected{% endif %} dir="auto">{{ text }}</option>
      {% endfor %}
    </select>
  {{ _close(name, form, hint) }}
{%- endmacro %}

{% macro checkbox(name, label, form, hint='') -%}
  <label class="check" for="f-{{ name }}">
    <input type="hidden" name="{{ name }}" value="0" />
    <input id="f-{{ name }}" name="{{ name }}" type="checkbox" value="1" {% if form.values[name] %}checked{% endif %} {% if hint %}aria-describedby="f-{{ name }}-hint"{% endif %} />
    <span>{{ label }}</span>
    {% if hint %}<span class="field__hint" id="f-{{ name }}-hint">{{ hint }}</span>{% endif %}
  </label>
{%- endmacro %}

{# Multiple choice from a fixed list, as a group of checkboxes with one legend. #}
{% macro checkboxGroup(name, label, form, options, full=true) -%}
  <fieldset class="field{% if full %} form-grid__full{% endif %}">
    <legend class="field__label">{{ label }}</legend>
    <div class="row row--wrap">
      {% for option in options %}
        <label class="check"><input type="checkbox" name="{{ name }}" value="{{ option }}" {% if option in (form.values[name] or []) %}checked{% endif %} /> <span>{{ option }}</span></label>
      {% endfor %}
    </div>
    <span class="field__error" aria-live="polite">{{ form.errors[name] }}</span>
  </fieldset>
{%- endmacro %}

{# Summary shown at the top of a form when the server rejected it. #}
{% macro formErrors(form) -%}
  {% if form.message %}
    <div class="notice notice--danger" role="alert" tabindex="-1" data-form-error>
      {{ icon('error') }}
      <div><p class="notice__title">{{ form.message }}</p>{% if form.detail %}<p>{{ form.detail }}</p>{% endif %}</div>
    </div>
  {% endif %}
{%- endmacro %}

{# ── Page header ──────────────────────────────────────────────────────────
   Put action buttons in the caller block:  {% call pageHeader('Employers') %} … {% endcall %} #}
{% macro pageHeader(title, meta='', breadcrumb=[]) -%}
  {% if breadcrumb.length %}
    <nav aria-label="Breadcrumb"><ol class="breadcrumb" role="list">
      {% for crumb in breadcrumb %}<li>{% if crumb.href %}<a href="{{ crumb.href }}" dir="auto">{{ crumb.label }}</a>{% else %}<span dir="auto" aria-current="page">{{ crumb.label }}</span>{% endif %}</li>{% endfor %}
    </ol></nav>
  {% endif %}
  <div class="page-header">
    <div>
      <h1 dir="auto">{{ title }}</h1>
      {% if meta %}<p class="page-header__meta">{{ meta }}</p>{% endif %}
    </div>
    <div class="page-header__actions">{{ caller() if caller }}</div>
  </div>
{%- endmacro %}

{# ── Badges ───────────────────────────────────────────────────────────────
   tone: '' (neutral) | success | warning | danger | info. Always dot + text. #}
{% macro badge(text, tone='') -%}
  <span class="badge{% if tone %} badge--{{ tone }}{% endif %}">{{ text }}</span>
{%- endmacro %}

{# ── Tables ───────────────────────────────────────────────────────────────
   Sortable column header. `list` is the object every list controller passes:
     list.sort, list.dir          current sort column and direction
     list.url(overrides)          builds the URL of this list with changed parameters
   Sorting is a normal link (works without JavaScript); htmx swaps only the results. #}
{% macro sortHeader(label, column, list, numeric=false) -%}
  {% set active = list.sort == column %}
  {% set nextDir = 'desc' if (active and list.dir == 'asc') else 'asc' %}
  <th scope="col" {% if numeric %}class="cell--num"{% endif %} {% if active %}aria-sort="{{ 'ascending' if list.dir == 'asc' else 'descending' }}"{% endif %}>
    <a class="table__sort" href="{{ list.url({ sort: column, dir: nextDir, page: 1 }) }}"
       hx-get="{{ list.url({ sort: column, dir: nextDir, page: 1 }) }}" hx-target="#results" hx-select="#results" hx-push-url="true">
      {{ label }}{{ icon('sort-up') }}
    </a>
  </th>
{%- endmacro %}

{# Footer under a table: "1–25 of 312" and page links. Always rendered, so its
   space is reserved whether there is one page or fifty. #}
{% macro tableFooter(list, noun='records') -%}
  <div class="table-footer">
    <span>
      {% if list.total %}{{ list.from }}–{{ list.to }} of {{ list.total }} {{ noun }}{% else %}No {{ noun }}{% endif %}
    </span>
    <nav class="pagination" aria-label="Pages">
      {% if list.page > 1 %}
        <a class="btn btn--sm" href="{{ list.url({ page: list.page - 1 }) }}" hx-get="{{ list.url({ page: list.page - 1 }) }}" hx-target="#results" hx-select="#results" hx-push-url="true" rel="prev">{{ icon('chevron-left') }}<span>Previous</span></a>
      {% else %}
        <span class="btn btn--sm" aria-disabled="true">{{ icon('chevron-left') }}<span>Previous</span></span>
      {% endif %}
      <span class="tabular">Page {{ list.page }} of {{ list.pages or 1 }}</span>
      {% if list.page < list.pages %}
        <a class="btn btn--sm" href="{{ list.url({ page: list.page + 1 }) }}" hx-get="{{ list.url({ page: list.page + 1 }) }}" hx-target="#results" hx-select="#results" hx-push-url="true" rel="next"><span>Next</span>{{ icon('chevron-right') }}</a>
      {% else %}
        <span class="btn btn--sm" aria-disabled="true"><span>Next</span>{{ icon('chevron-right') }}</span>
      {% endif %}
    </nav>
  </div>
{%- endmacro %}

{# ── Empty state ──────────────────────────────────────────────────────────
   Say what is missing and what to do next. Actions go in the caller block. #}
{% macro emptyState(title, text='') -%}
  <div class="empty">
    <p class="empty__title">{{ title }}</p>
    {% if text %}<p>{{ text }}</p>{% endif %}
    {% if caller %}<div class="empty__actions">{{ caller() }}</div>{% endif %}
  </div>
{%- endmacro %}

{# ── "Last edited" line ───────────────────────────────────────────────────
   Shown on every record page; links to the record's history when permitted. #}
{% macro lastEdited(record, historyUrl='') -%}
  <p class="text-sm text-muted">
    Last edited by <span dir="auto">{{ record.updatedByName or 'system' }}</span> on {{ record.UpdatedAt | datetime }}
    {% if historyUrl %}· <a href="{{ historyUrl }}">View history</a>{% endif %}
  </p>
{%- endmacro %}

{# ── Withheld value ───────────────────────────────────────────────────────
   For a field the current role may not see. Never render it as empty. #}
{% macro restricted() -%}
  <span class="text-subtle">{{ icon('lock') }} Restricted</span>
{%- endmacro %}

{# ── Confirmation of a destructive action ─────────────────────────────────
   Renders the trigger button. app.js opens the shared dialog with a message
   that names the record ("Delete Zayvora Digital?"), and submits the form only
   after confirmation. Works without JavaScript by going to a confirm page. #}
{% macro deleteForm(action, recordName, csrfToken, what='', label='Delete') -%}
  <form action="{{ action }}" method="post" data-confirm
        data-confirm-title="Delete {{ recordName }}?"
        data-confirm-text="{{ what or (recordName ~ ' moves to the Trash. You can restore it from there.') }}"
        data-confirm-action="Delete">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {{ button(label, 'danger', 'submit', 'trash') }}
  </form>
{%- endmacro %}

{# ── Small action form ────────────────────────────────────────────────────
   A POST button for a table row (Restore in the Trash). `returnTo` brings the
   person back to the same page afterwards. With `confirm` ({ title, text,
   action }) the shared dialog asks first, as for deleteForm. #}
{% macro actionForm(action, label, csrfToken, ariaLabel, returnTo='', variant='', confirm=null) -%}
  <form action="{{ action }}" method="post"
        {% if confirm %}data-confirm data-confirm-title="{{ confirm.title }}" data-confirm-text="{{ confirm.text }}" data-confirm-action="{{ confirm.action }}"{% endif %}>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {% if returnTo %}<input type="hidden" name="returnTo" value="{{ returnTo }}" />{% endif %}
    {{ button(label, variant, 'submit', '', 'aria-label="' ~ (ariaLabel | escape) ~ '"', true) }}
  </form>
{%- endmacro %}
